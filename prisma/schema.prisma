generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  executions  Execution[]

  @@index([status, createdAt])
}

model Execution {
  id              String           @id @default(cuid())
  projectId       String
  status          String           @default("CREATED")
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  agentExecutions AgentExecution[]
  artifacts       Artifact[]
  logs            Log[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model PromptVersion {
  id              String           @id @default(cuid())
  agent           String
  version         String
  schemaVersion   String
  content         String
  hash            String
  status          String           @default("DRAFT")
  description     String?
  source          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  agentExecutions AgentExecution[]

  @@unique([agent, version])
  @@index([agent, status])
  @@index([hash])
}

model AgentExecution {
  id            String        @id @default(cuid())
  executionId   String
  agent         String
  status        String        @default("CREATED")
  attempt       Int
  input         Json
  output        Json?
  agentVersion  String
  promptVersion String
  schemaVersion String
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int?
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  execution     Execution     @relation(fields: [executionId], references: [id], onDelete: Restrict)
  prompt        PromptVersion @relation(fields: [agent, promptVersion], references: [agent, version], onDelete: Restrict, onUpdate: Restrict)
  artifacts     Artifact[]
  logs          Log[]

  @@unique([executionId, agent, attempt])
  @@index([executionId, createdAt])
  @@index([agent, status, createdAt])
}

model Artifact {
  id               String         @id @default(cuid())
  executionId      String
  agentExecutionId String
  name             String
  filename         String
  type             String
  content          String
  version          Int
  provenance       Json
  createdAt        DateTime       @default(now())
  execution        Execution      @relation(fields: [executionId], references: [id], onDelete: Restrict)
  agentExecution   AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Restrict)
  logs             Log[]

  @@unique([executionId, filename, version])
  @@index([executionId, createdAt])
  @@index([agentExecutionId, createdAt])
  @@index([type, createdAt])
}

model Log {
  id               String          @id @default(cuid())
  executionId      String
  agentExecutionId String?
  artifactId       String?
  level            String
  event            String
  message          String?
  context          Json
  requestId        String?
  traceId          String?
  createdAt        DateTime        @default(now())
  execution        Execution       @relation(fields: [executionId], references: [id], onDelete: Restrict)
  agentExecution   AgentExecution? @relation(fields: [agentExecutionId], references: [id], onDelete: SetNull)
  artifact         Artifact?       @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([executionId, createdAt])
  @@index([agentExecutionId, createdAt])
  @@index([artifactId, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
  @@index([traceId])
}

model User {
  id               String            @id
  email            String            @unique
  name             String
  emailVerified    Boolean           @default(false)
  image            String?
  role             String            @default("USER")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  executionRecords ExecutionRecord[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model ExecutionRecord {
  storageId         String                          @id @default(cuid())
  userId            String
  workflowId        String                          @unique
  executionId       String?                         @unique
  requestId         String?
  traceId           String?
  projectName       String
  status            String                          @default("CREATED")
  workflowStatus    String?
  readiness         String?
  createdAt         DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  engineVersion     String
  contractVersion   String
  attempt           Int                             @default(1)
  revision          Int                             @default(0)
  failureKind       String?
  failureCode       String?
  failureSourceCode String?
  hashes            ExecutionRecordHash?
  job               ExecutionJob?
  lifecycleEvents   ExecutionRecordLifecycleEvent[]
  observation       ExecutionObservation?
  lineageOutput     ExecutionLineageOutput?
  lineageHandoffs   ExecutionLineageHandoff[]
  provenanceStages  ExecutionProvenanceStage[]
  factoryResult     ExecutionFactoryResult?
  previewArtifacts  PreviewArtifact[]
  previewSessions   PreviewSession[]
  user              User                            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, readiness, createdAt])
  @@index([status, createdAt])
  @@index([readiness, createdAt])
  @@index([requestId])
  @@index([finishedAt])
}

model ExecutionJob {
  jobId             String          @id
  executionRecordId String          @unique
  status            String
  queuedAt          DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  executionRecord   ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@index([status, queuedAt])
  @@index([finishedAt])
}

model ExecutionRecordHash {
  executionRecordId    String          @id
  executionRequestHash String?
  workflowRequestHash  String?
  workflowHash         String?
  lineageHash          String?
  provenanceHash       String?
  executionHash        String?
  executionRecord      ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@index([executionHash])
}

model ExecutionRecordLifecycleEvent {
  id                String          @id @default(cuid())
  executionRecordId String
  sequence          Int
  event             String
  state             String
  occurredAt        DateTime
  durationMs        Int?
  executionRecord   ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@unique([executionRecordId, sequence])
  @@index([executionRecordId, occurredAt])
}

model ExecutionObservation {
  executionRecordId        String                      @id
  observabilityVersion     String
  revision                 Int
  executionId              String
  workflowId               String
  requestId                String?
  status                   String
  updatedAt                DateTime
  summaryWorkflowStatus    String?
  summaryFactoryStatus     String?
  summaryFactoryResultHash String?
  summaryReadinessFinal    String?
  summaryTotalDurationMs   Int?
  summaryTotalTokens       Int?
  summaryCostAmount        Float?
  summaryCostCurrency      String?
  summaryRateCardVersion   String?
  executionRecord          ExecutionRecord             @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  events                   ExecutionObservationEvent[]
  stages                   ExecutionObservedStage[]

  @@index([executionId])
  @@index([workflowId])
  @@index([status, updatedAt])
}

model ExecutionObservedStage {
  id                     String                @id @default(cuid())
  executionObservationId String
  ordinal                Int
  stageId                String
  stageName              String
  status                 String
  startedAt              DateTime?
  finishedAt             DateTime?
  durationMs             Int?
  requestId              String?
  executionId            String
  executionObservation   ExecutionObservation  @relation(fields: [executionObservationId], references: [executionRecordId], onDelete: Restrict)
  metrics                ExecutionStageMetric?

  @@unique([executionObservationId, stageId])
  @@unique([executionObservationId, ordinal])
  @@index([status])
}

model ExecutionStageMetric {
  executionObservedStageId     String                 @id
  stageId                      String
  durationMs                   Int?
  promptBytes                  Int?
  completionBytes              Int?
  inputTokens                  Int?
  outputTokens                 Int?
  totalTokens                  Int?
  providerLatencyMs            Int?
  validationDurationMs         Int?
  artifactGenerationDurationMs Int?
  executionObservedStage       ExecutionObservedStage @relation(fields: [executionObservedStageId], references: [id], onDelete: Restrict)
}

model ExecutionObservationEvent {
  id                     String               @id @default(cuid())
  executionObservationId String
  sequence               Int
  type                   String
  stageId                String
  stageName              String
  status                 String
  startedAt              DateTime?
  finishedAt             DateTime?
  durationMs             Int?
  requestId              String?
  executionId            String
  errorCode              String?
  executionObservation   ExecutionObservation @relation(fields: [executionObservationId], references: [executionRecordId], onDelete: Restrict)

  @@unique([executionObservationId, sequence])
  @@index([executionObservationId, status])
}

model ExecutionLineageOutput {
  executionRecordId             String          @id
  productOwnerSpecificationHash String?
  technicalSpecificationHash    String?
  qaSpecificationHash           String?
  executionRecord               ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
}

model ExecutionLineageHandoff {
  id                String          @id @default(cuid())
  executionRecordId String
  ordinal           Int
  fromStage         String
  toStage           String
  specification     String
  calculatedHash    String
  declaredHash      String
  verified          Boolean
  executionRecord   ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@unique([executionRecordId, ordinal])
}

model ExecutionProvenanceStage {
  id                   String                            @id @default(cuid())
  executionRecordId    String
  ordinal              Int
  stage                String
  agent                String
  executionId          String
  agentExecutionId     String
  agentVersion         String
  outcome              String
  readiness            String?
  assetBundleHash      String
  knowledgeContextHash String
  promptHash           String
  responseHash         String
  validationHash       String
  generationHash       String?
  executionRecord      ExecutionRecord                   @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  artifactHashes       ExecutionProvenanceArtifactHash[]

  @@unique([executionRecordId, ordinal])
  @@index([stage, outcome])
}

model ExecutionProvenanceArtifactHash {
  id                         String                   @id @default(cuid())
  executionProvenanceStageId String
  ordinal                    Int
  hash                       String
  executionProvenanceStage   ExecutionProvenanceStage @relation(fields: [executionProvenanceStageId], references: [id], onDelete: Restrict)

  @@unique([executionProvenanceStageId, ordinal])
  @@index([hash])
}

model ExecutionFactoryResult {
  executionRecordId      String                             @id
  factoryVersion         String
  contractVersion        String
  status                 String
  startedAt              DateTime
  finishedAt             DateTime
  durationMs             Int
  readiness              String?
  terminalStage          String
  factoryResultHash      String
  lineageHash            String
  provenanceHash         String
  generationStatus       String
  generatedFileCount     Int?
  generatedTotalBytes    Int?
  workspaceId            String?
  workspaceFileCount     Int?
  workspaceTotalBytes    Int?
  workspaceReleaseStatus String
  sandboxStatus          String
  sandboxRunId           String?
  sandboxResourceOutcome String
  failureKind            String?
  failureCode            String?
  failureSourceCode      String?
  failureReasonCode      String?
  failureStageId         String?
  executionRecord        ExecutionRecord                    @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  stages                 ExecutionFactoryStageResult[]
  lineage                ExecutionFactoryLineage?
  provenance             ExecutionFactoryProvenance?
  toolchainVersions      ExecutionFactoryToolchainVersion[]

  @@index([status, finishedAt])
  @@index([factoryResultHash])
}

model ExecutionFactoryStageResult {
  id                       String                 @id @default(cuid())
  executionFactoryResultId String
  ordinal                  Int
  stageId                  String
  status                   String
  startedAt                DateTime?
  finishedAt               DateTime?
  durationMs               Int?
  outputHash               String?
  failureCode              String?
  reasonCode               String?
  resourceOutcome          String?
  executionFactoryResult   ExecutionFactoryResult @relation(fields: [executionFactoryResultId], references: [executionRecordId], onDelete: Restrict)

  @@unique([executionFactoryResultId, ordinal])
  @@unique([executionFactoryResultId, stageId])
  @@index([stageId, status])
}

model ExecutionFactoryLineage {
  executionFactoryResultId      String                 @id
  productOwnerSpecificationHash String?
  technicalSpecificationHash    String?
  qaSpecificationHash           String?
  executionHash                 String
  workflowHash                  String?
  generationHash                String?
  bundleHash                    String?
  bundleContentHash             String?
  workspacePlanHash             String?
  workspaceHash                 String?
  sandboxRequestHash            String?
  sandboxResultHash             String?
  executionProfileHash          String?
  generationProjectionHash      String?
  profileValidationHash         String?
  factoryResultHash             String
  executionFactoryResult        ExecutionFactoryResult @relation(fields: [executionFactoryResultId], references: [executionRecordId], onDelete: Restrict)
}

model ExecutionFactoryProvenance {
  executionFactoryResultId      String                 @id
  codeGeneratorAgentVersion     String?
  codeGeneratorContractVersion  String?
  codeGeneratorAssetBundleHash  String?
  executionProfileId            String?
  executionProfileVersion       String?
  executionProfileContractVersion String?
  executionProfileHash          String?
  generationProjectionHash      String?
  profileValidationHash         String?
  workspaceVersion              String?
  workspaceContractVersion      String?
  workspacePolicyHash           String?
  workspaceConfigurationHash    String?
  sandboxRunnerVersion          String?
  sandboxContractVersion        String?
  sandboxSanitizerVersion       String?
  sandboxHelperAbiVersion       String?
  sandboxDependencySnapshotHash String?
  sandboxPolicyId               String?
  sandboxPolicyVersion          String?
  sandboxPolicyHash             String?
  sandboxCommandPolicyHash      String?
  sandboxLimitsHash             String?
  sandboxAdapter                String?
  sandboxImageDigest            String?
  sandboxImageId                String?
  sandboxPlatform               String?
  sandboxRuntimeName            String?
  sandboxRuntimeVersion         String?
  executionFactoryResult        ExecutionFactoryResult @relation(fields: [executionFactoryResultId], references: [executionRecordId], onDelete: Restrict)
}

model ExecutionFactoryToolchainVersion {
  id                       String                 @id @default(cuid())
  executionFactoryResultId String
  name                     String
  version                  String
  executionFactoryResult   ExecutionFactoryResult @relation(fields: [executionFactoryResultId], references: [executionRecordId], onDelete: Restrict)

  @@unique([executionFactoryResultId, name])
  @@index([name, version])
}

model PreviewArtifact {
  artifactId          String          @id
  executionRecordId   String
  status              String
  artifactVersion     String
  contractVersion     String
  hashAlgorithm       String
  profileId           String
  exporterVersion     String
  fileCount           Int
  totalBytes          Int
  createdAt           DateTime
  approvedAt          DateTime?
  expiresAt           DateTime
  consumedAt          DateTime?
  deletedAt           DateTime?
  workspaceHash       String
  sandboxRequestHash  String
  factoryResultHash   String?
  sandboxResultHash   String?
  artifactContentHash String
  artifactHash        String          @unique
  approvalHash        String?         @unique
  revision            Int             @default(0)
  executionRecord     ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  previewSession      PreviewSession?

  @@index([executionRecordId, createdAt])
  @@index([status, expiresAt])
  @@index([workspaceHash])
}

model PreviewSession {
  previewId            String                    @id
  executionRecordId    String                    @unique
  artifactId           String                    @unique
  status               String
  health               String
  policyId             String
  policyVersion        String
  artifactProfileId    String
  artifactFileCount    Int
  artifactTotalBytes   Int
  artifactExpiresAt    DateTime
  createdAt            DateTime
  startedAt            DateTime?
  expiresAt            DateTime
  stoppingAt           DateTime?
  stoppedAt            DateTime?
  revision             Int                       @default(0)
  ttlSeconds           Int
  startupTimeoutMs     Int
  healthTimeoutMs      Int
  stopTimeoutMs        Int
  cpus                 Float
  memoryBytes          Int
  pidsLimit            Int
  openFilesLimit       Int
  temporaryBytes       Int
  artifactBytes        Int
  artifactFiles        Int
  responseBytes        Int
  responseTimeoutMs    Int
  capturedLogBytes     Int
  maxLogLineBytes      Int
  factoryResultHash    String
  sandboxRequestHash   String
  sandboxResultHash    String
  workspaceHash        String
  artifactHash         String
  artifactApprovalHash String
  policyHash           String
  limitsHash           String
  previewRequestHash   String
  lineageHash          String
  provenanceHash       String
  previewSessionHash   String
  failureCode          String?
  failureStage         String?
  failureSourceCode    String?
  executionRecord      ExecutionRecord           @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  artifact             PreviewArtifact           @relation(fields: [artifactId], references: [artifactId], onDelete: Restrict)
  events               PreviewSessionEvent[]
  provenance           PreviewSessionProvenance?
  accessTicket         PreviewAccessTicket?

  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([previewSessionHash])
}

model PreviewSessionEvent {
  id                 String         @id @default(cuid())
  previewSessionId   String
  sequence           Int
  event              String
  status             String
  occurredAt         DateTime
  durationMs         Int?
  artifactHash       String
  previewRequestHash String
  previewSessionHash String
  policyId           String
  failureCode        String?
  contractVersion    String
  previewSession     PreviewSession @relation(fields: [previewSessionId], references: [previewId], onDelete: Restrict)

  @@unique([previewSessionId, sequence])
  @@index([previewSessionId, occurredAt])
  @@index([event, occurredAt])
}

model PreviewSessionProvenance {
  previewSessionId        String         @id
  runnerVersion           String
  contractVersion         String
  hashAlgorithm           String
  artifactVersion         String
  artifactContractVersion String
  exporterVersion         String
  policyId                String
  policyVersion           String
  policyHash              String
  limitsHash              String
  runtimeAdapter          String?
  runtimeEngineName       String?
  runtimeEngineVersion    String?
  runtimeImageReference   String?
  runtimeImageDigest      String?
  runtimeImageId          String?
  runtimePlatform         String?
  runtimeName             String?
  runtimeVersion          String?
  runtimeServerAbiVersion String?
  previewSession          PreviewSession @relation(fields: [previewSessionId], references: [previewId], onDelete: Restrict)

  @@index([policyId, policyVersion])
  @@index([runtimeImageDigest])
}

model PreviewAccessTicket {
  previewSessionId String         @id
  ticketHash       String         @unique
  issuedAt         DateTime
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  previewSession   PreviewSession @relation(fields: [previewSessionId], references: [previewId], onDelete: Restrict)

  @@index([expiresAt])
}
