generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  executions  Execution[]

  @@index([status, createdAt])
}

model Execution {
  id              String           @id @default(cuid())
  projectId       String
  status          String           @default("CREATED")
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  agentExecutions AgentExecution[]
  artifacts       Artifact[]
  logs            Log[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model PromptVersion {
  id              String           @id @default(cuid())
  agent           String
  version         String
  schemaVersion   String
  content         String
  hash            String
  status          String           @default("DRAFT")
  description     String?
  source          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  agentExecutions AgentExecution[]

  @@unique([agent, version])
  @@index([agent, status])
  @@index([hash])
}

model AgentExecution {
  id            String        @id @default(cuid())
  executionId   String
  agent         String
  status        String        @default("CREATED")
  attempt       Int
  input         Json
  output        Json?
  agentVersion  String
  promptVersion String
  schemaVersion String
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int?
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  execution     Execution     @relation(fields: [executionId], references: [id], onDelete: Restrict)
  prompt        PromptVersion @relation(fields: [agent, promptVersion], references: [agent, version], onDelete: Restrict, onUpdate: Restrict)
  artifacts     Artifact[]
  logs          Log[]

  @@unique([executionId, agent, attempt])
  @@index([executionId, createdAt])
  @@index([agent, status, createdAt])
}

model Artifact {
  id               String         @id @default(cuid())
  executionId      String
  agentExecutionId String
  name             String
  filename         String
  type             String
  content          String
  version          Int
  provenance       Json
  createdAt        DateTime       @default(now())
  execution        Execution      @relation(fields: [executionId], references: [id], onDelete: Restrict)
  agentExecution   AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Restrict)
  logs             Log[]

  @@unique([executionId, filename, version])
  @@index([executionId, createdAt])
  @@index([agentExecutionId, createdAt])
  @@index([type, createdAt])
}

model Log {
  id               String          @id @default(cuid())
  executionId      String
  agentExecutionId String?
  artifactId       String?
  level            String
  event            String
  message          String?
  context          Json
  requestId        String?
  traceId          String?
  createdAt        DateTime        @default(now())
  execution        Execution       @relation(fields: [executionId], references: [id], onDelete: Restrict)
  agentExecution   AgentExecution? @relation(fields: [agentExecutionId], references: [id], onDelete: SetNull)
  artifact         Artifact?       @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@index([executionId, createdAt])
  @@index([agentExecutionId, createdAt])
  @@index([artifactId, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
  @@index([traceId])
}

model ExecutionRecord {
  storageId         String                          @id @default(cuid())
  workflowId        String                          @unique
  executionId       String?                         @unique
  requestId         String?
  traceId           String?
  projectName       String
  status            String                          @default("CREATED")
  workflowStatus    String?
  readiness         String?
  createdAt         DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  engineVersion     String
  contractVersion   String
  attempt           Int                             @default(1)
  revision          Int                             @default(0)
  failureKind       String?
  failureCode       String?
  failureSourceCode String?
  hashes            ExecutionRecordHash?
  job               ExecutionJob?
  lifecycleEvents   ExecutionRecordLifecycleEvent[]
  observation       ExecutionObservation?
  lineageOutput     ExecutionLineageOutput?
  lineageHandoffs   ExecutionLineageHandoff[]
  provenanceStages  ExecutionProvenanceStage[]

  @@index([status, createdAt])
  @@index([readiness, createdAt])
  @@index([requestId])
  @@index([finishedAt])
}

model ExecutionJob {
  jobId             String          @id
  executionRecordId String          @unique
  status            String
  queuedAt          DateTime
  startedAt         DateTime?
  finishedAt        DateTime?
  executionRecord   ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@index([status, queuedAt])
  @@index([finishedAt])
}

model ExecutionRecordHash {
  executionRecordId    String          @id
  executionRequestHash String?
  workflowRequestHash  String?
  workflowHash         String?
  lineageHash          String?
  provenanceHash       String?
  executionHash        String?
  executionRecord      ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@index([executionHash])
}

model ExecutionRecordLifecycleEvent {
  id                String          @id @default(cuid())
  executionRecordId String
  sequence          Int
  event             String
  state             String
  occurredAt        DateTime
  durationMs        Int?
  executionRecord   ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@unique([executionRecordId, sequence])
  @@index([executionRecordId, occurredAt])
}

model ExecutionObservation {
  executionRecordId      String                      @id
  observabilityVersion   String
  revision               Int
  executionId            String
  workflowId             String
  requestId              String?
  status                 String
  updatedAt              DateTime
  summaryWorkflowStatus  String?
  summaryReadinessFinal  String?
  summaryTotalDurationMs Int?
  summaryTotalTokens     Int?
  summaryCostAmount      Float?
  summaryCostCurrency    String?
  summaryRateCardVersion String?
  executionRecord        ExecutionRecord             @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  events                 ExecutionObservationEvent[]
  stages                 ExecutionObservedStage[]

  @@index([executionId])
  @@index([workflowId])
  @@index([status, updatedAt])
}

model ExecutionObservedStage {
  id                     String                @id @default(cuid())
  executionObservationId String
  ordinal                Int
  stageId                String
  stageName              String
  status                 String
  startedAt              DateTime?
  finishedAt             DateTime?
  durationMs             Int?
  requestId              String?
  executionId            String
  executionObservation   ExecutionObservation  @relation(fields: [executionObservationId], references: [executionRecordId], onDelete: Restrict)
  metrics                ExecutionStageMetric?

  @@unique([executionObservationId, stageId])
  @@unique([executionObservationId, ordinal])
  @@index([status])
}

model ExecutionStageMetric {
  executionObservedStageId     String                 @id
  stageId                      String
  durationMs                   Int?
  promptBytes                  Int?
  completionBytes              Int?
  inputTokens                  Int?
  outputTokens                 Int?
  totalTokens                  Int?
  providerLatencyMs            Int?
  validationDurationMs         Int?
  artifactGenerationDurationMs Int?
  executionObservedStage       ExecutionObservedStage @relation(fields: [executionObservedStageId], references: [id], onDelete: Restrict)
}

model ExecutionObservationEvent {
  id                     String               @id @default(cuid())
  executionObservationId String
  sequence               Int
  type                   String
  stageId                String
  stageName              String
  status                 String
  startedAt              DateTime?
  finishedAt             DateTime?
  durationMs             Int?
  requestId              String?
  executionId            String
  errorCode              String?
  executionObservation   ExecutionObservation @relation(fields: [executionObservationId], references: [executionRecordId], onDelete: Restrict)

  @@unique([executionObservationId, sequence])
  @@index([executionObservationId, status])
}

model ExecutionLineageOutput {
  executionRecordId             String          @id
  productOwnerSpecificationHash String?
  technicalSpecificationHash    String?
  qaSpecificationHash           String?
  executionRecord               ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
}

model ExecutionLineageHandoff {
  id                String          @id @default(cuid())
  executionRecordId String
  ordinal           Int
  fromStage         String
  toStage           String
  specification     String
  calculatedHash    String
  declaredHash      String
  verified          Boolean
  executionRecord   ExecutionRecord @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)

  @@unique([executionRecordId, ordinal])
}

model ExecutionProvenanceStage {
  id                   String                            @id @default(cuid())
  executionRecordId    String
  ordinal              Int
  stage                String
  agent                String
  executionId          String
  agentExecutionId     String
  agentVersion         String
  outcome              String
  readiness            String?
  assetBundleHash      String
  knowledgeContextHash String
  promptHash           String
  responseHash         String
  validationHash       String
  generationHash       String?
  executionRecord      ExecutionRecord                   @relation(fields: [executionRecordId], references: [storageId], onDelete: Restrict)
  artifactHashes       ExecutionProvenanceArtifactHash[]

  @@unique([executionRecordId, ordinal])
  @@index([stage, outcome])
}

model ExecutionProvenanceArtifactHash {
  id                         String                   @id @default(cuid())
  executionProvenanceStageId String
  ordinal                    Int
  hash                       String
  executionProvenanceStage   ExecutionProvenanceStage @relation(fields: [executionProvenanceStageId], references: [id], onDelete: Restrict)

  @@unique([executionProvenanceStageId, ordinal])
  @@index([hash])
}
