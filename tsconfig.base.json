{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@brq/agent-runner/*": ["./core/agent-runner/*"],
      "@brq/ai-provider/*": ["./core/ai-provider/*"],
      "@brq/knowledge-loader/*": ["./core/knowledge-loader/*"],
      "@brq/prompt-builder/*": ["./core/prompt-builder/*"],
      "@brq/prompt-inspector/*": ["./core/prompt-inspector/*"],
      "@brq/response-validator/*": ["./core/response-validator/*"],
      "@brq/shared/*": ["./shared/*"]
    }
  }
}
