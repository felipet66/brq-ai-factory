{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "agents/code-generator/**/*.ts",
    "agents/developer/**/*.ts",
    "agents/product-owner/**/*.ts",
    "agents/qa/**/*.ts",
    "core/adaptive-orchestrator/**/*.ts",
    "core/agent-runner/**/*.ts",
    "core/ai-provider/**/*.ts",
    "core/artifact-generator/**/*.ts",
    "core/agent-contract-invariants/**/*.ts",
    "core/controlled-workspace/**/*.ts",
    "core/factory-execution-profile/**/*.ts",
    "core/sandbox-runner/**/*.ts",
    "core/factory-pipeline/**/*.ts",
    "core/execution-engine/**/*.ts",
    "core/execution-repository/**/*.ts",
    "core/execution-worker/**/*.ts",
    "core/job-queue/**/*.ts",
    "core/knowledge-loader/**/*.ts",
    "core/observability/**/*.ts",
    "core/orchestrator/**/*.ts",
    "core/prompt-builder/**/*.ts",
    "core/prompt-inspector/**/*.ts",
    "core/preview-artifact/**/*.ts",
    "core/preview-runner/**/*.ts",
    "core/response-validator/**/*.ts",
    "prisma.config.ts",
    "prisma/**/*.ts",
    "shared/**/*.ts",
    "vitest.config.ts",
    "vitest.ai-live.config.ts",
    "vitest.sandbox-integration.config.ts",
    "vitest.preview-integration.config.ts"
  ],
  "exclude": ["node_modules", "apps"]
}
